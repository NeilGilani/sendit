; Engine configuration file.
; SENDIT - a peaceful skiing game.

config_version=5

[application]

config/name="SENDIT"
config/description="A peaceful, zen skiing game at golden hour."
run/main_scene="res://core/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://core/event_bus.gd"
GameState="*res://core/game_state.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[editor_plugins]

enabled=PackedStringArray()

[filesystem]

import/blender/enabled=false

