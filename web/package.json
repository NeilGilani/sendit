{
  "name": "sendit-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SENDIT — a peaceful skiing game in the browser (Three.js)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build --base /sendit/",
    "preview": "vite preview",
    "serve:dist": "node scripts/serve-dist.mjs dist 4173 /",
    "smoke": "node scripts/prodsmoke.mjs http://localhost:4173/",
    "play": "vite build && vite preview --host --port 4173"
  },
  "dependencies": {
    "meshoptimizer": "0.22.0",
    "n8ao": "1.9.4",
    "postprocessing": "6.36.4",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "vite": "5.4.11"
  }
}
